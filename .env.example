# Plantilla de variables de entorno para BrewFlow.
# Copia este archivo como .env y coloca tus valores. El .env real está en .gitignore.
#
# AVISO: las variables VITE_* se incrustan en el JavaScript público al hacer el build.
# Es un control del lado del cliente para evitar accesos casuales, no seguridad real.

# Usuario del login (si falta, se usa "barista").
VITE_CORRECT_USER=barista

# Hash SHA-256 en hexadecimal (64 caracteres) de la contraseña. OBLIGATORIA:
# sin esta variable el login rechaza cualquier contraseña y muestra
# "Acceso no configurado". No existe ningún valor por defecto.
# Para generarlo (sin guardar la contraseña en el historial de la shell):
#   printf '%s' 'mi-contraseña' | shasum -a 256 | cut -d' ' -f1
# Si el valor no mide 64 caracteres se compara como texto plano (no recomendado).
VITE_CORRECT_PASS_HASH=
